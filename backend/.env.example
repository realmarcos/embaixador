# APP CONFIGURATION
PORT=8080
NODE_ENV=development

# DATABASE
DATABASE_URL=mysql://user:password@localhost:3306/embaixador

# AUTHENTICATION AND URL ENCRYPTION
JWT_SIGNING_KEY=
SOURCE_URL_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:3000

# PRIVATE S3-COMPATIBLE STORAGE
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MEDIA WORKER
MEDIA_TEMP_DIRECTORY=/tmp/embaixador
YT_DLP_PATH=/usr/bin/yt-dlp
# Optional HTTP upstream proxy; URL-encode username and password individually.
YT_DLP_PROXY=
FFMPEG_PATH=/usr/bin/ffmpeg
