{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend embaixador aplication.",
  "main": "index.ts",
  "engines": {
    "node": ">=24 <25"
  },
  "author": "Marcos Raimundo Mendes Ramos",
  "license": "MIT",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest src",
    "test:coverage": "vitest src --coverage",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@prisma/client": "^6.12.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  }
}
